    "body": "<!DOCTYPE html>\n<html lang=\"pt-BR\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>SecNotes - Login</title>\n  <style>\n  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }\n  body {\n    font-family: 'Segoe UI', system-ui, sans-serif;\n    background: #0d1117;\n    color: #c9d1d9;\n    min-height: 100vh;\n  }\n  nav {\n    background: #161b22;\n    border-bottom: 1px solid #30363d;\n    padding: 0.9rem 2rem;\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    position: sticky;\n    top: 0;\n    z-index: 10;\n  }\n  .nav-brand { font-size: 1.1rem; font-weight: 700; color: #58a6ff; letter-spacing: 0.03em; }\n  .nav-links a {\n    color: #8b949e;\n    text-decoration: none;\n    margin-left: 1.4rem;\n    font-size: 0.88rem;\n    transition: color 0.15s;\n  }\n  .nav-links a:hover { color: #e6edf3; }\n  main { max-width: 820px; margin: 0 auto; padding: 2.5rem 1.2rem 4rem; }\n  .hero {\n    text-align: center;\n    padding: 3rem 0 2.5rem;\n    border-bottom: 1px solid #21262d;\n    margin-bottom: 2rem;\n  }\n  .hero h1 { font-size: 2rem; color: #e6edf3; font-weight: 700; letter-spacing: -0.01em; margin-bottom: 0.5rem; }\n  .hero p { color: #8b949e; font-size: 0.95rem; }\n  .greeting {\n    background: #161b22;\n    border: 1px solid #30363d;\n    border-left: 3px solid #58a6ff;\n    border-radius: 6px;\n    padding: 0.75rem 1.2rem;\n    margin-bottom: 2rem;\n    font-size: 0.92rem;\n  }\n  .posts { display: grid; gap: 1rem; }\n  .card {\n    background: #161b22;\n    border: 1px solid #30363d;\n    border-radius: 8px;\n    padding: 1.4rem 1.6rem;\n    transition: border-color 0.15s;\n  }\n  .card:hover { border-color: #58a6ff; }\n  .card-meta { display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem; }\n  .card h3 { color: #e6edf3; font-size: 1rem; font-weight: 600; }\n  .card p  { color: #8b949e; font-size: 0.88rem; line-height: 1.65; margin-top: 0.4rem; }\n  .tag {\n    font-size: 0.72rem;\n    background: #1c2d3f;\n    color: #58a6ff;\n    border: 1px solid #1f4068;\n    padding: 2px 9px;\n    border-radius: 20px;\n    white-space: nowrap;\n  }\n  .date { font-size: 0.75rem; color: #484f58; }\n  .section-title {\n    font-size: 1.1rem;\n    color: #e6edf3;\n    font-weight: 600;\n    margin-bottom: 1.2rem;\n    padding-bottom: 0.5rem;\n    border-bottom: 1px solid #21262d;\n  }\n  .comment-form {\n    background: #161b22;\n    border: 1px solid #30363d;\n    border-radius: 8px;\n    padding: 1.4rem 1.6rem;\n    margin-bottom: 2rem;\n  }\n  .form-group { margin-bottom: 1rem; }\n  .form-group label { display: block; font-size: 0.82rem; color: #8b949e; margin-bottom: 0.4rem; }\n  .form-group input,\n  .form-group textarea {\n    width: 100%;\n    background: #0d1117;\n    border: 1px solid #30363d;\n    border-radius: 6px;\n    padding: 0.6rem 0.9rem;\n    color: #c9d1d9;\n    font-size: 0.9rem;\n    font-family: inherit;\n    outline: none;\n    transition: border-color 0.15s;\n  }\n  .form-group input:focus,\n  .form-group textarea:focus { border-color: #58a6ff; }\n  .form-group textarea { resize: vertical; min-height: 80px; }\n  .btn {\n    background: #1f6feb;\n    color: #fff;\n    border: none;\n    border-radius: 6px;\n    padding: 0.55rem 1.4rem;\n    font-size: 0.88rem;\n    cursor: pointer;\n    transition: background 0.15s;\n  }\n  .btn:hover { background: #388bfd; }\n  .comment-list { display: grid; gap: 1rem; }\n  .comment-card {\n    background: #161b22;\n    border: 1px solid #30363d;\n    border-radius: 8px;\n    padding: 1.2rem 1.4rem;\n  }\n  .comment-author { font-size: 0.85rem; font-weight: 600; color: #58a6ff; margin-bottom: 0.4rem; }\n  .comment-body   { font-size: 0.88rem; color: #8b949e; line-height: 1.6; }\n  .empty-state    { text-align: center; padding: 3rem 0; color: #484f58; font-size: 0.9rem; }\n  .login-wrapper  { max-width: 400px; margin: 4rem auto 0; }\n  .login-card {\n    background: #161b22;\n    border: 1px solid #30363d;\n    border-radius: 10px;\n    padding: 2rem;\n  }\n  .login-card h2 { color: #e6edf3; font-size: 1.2rem; font-weight: 600; margin-bottom: 1.5rem; text-align: center; }\n  .alert-error {\n    background: #2d1117;\n    border: 1px solid #f85149;\n    border-radius: 6px;\n    padding: 0.6rem 1rem;\n    font-size: 0.85rem;\n    color: #f85149;\n    margin-bottom: 1rem;\n  }\n  .dashboard-header {\n    background: #161b22;\n    border: 1px solid #30363d;\n    border-left: 3px solid #3fb950;\n    border-radius: 6px;\n    padding: 0.75rem 1.2rem;\n    margin-bottom: 2rem;\n    font-size: 0.92rem;\n    color: #3fb950;\n  }\n  .dashboard-card {\n    background: #161b22;\n    border: 1px solid #30363d;\n    border-radius: 8px;\n    padding: 1.4rem 1.6rem;\n    margin-bottom: 1rem;\n  }\n  .dashboard-card h3 { color: #e6edf3; font-size: 0.95rem; font-weight: 600; margin-bottom: 0.8rem; }\n  .dashboard-card p  { color: #8b949e; font-size: 0.85rem; line-height: 1.6; }\n  .badge {\n    display: inline-block;\n    background: #1a3a1f;\n    color: #3fb950;\n    border: 1px solid #2ea043;\n    font-size: 0.72rem;\n    padding: 2px 9px;\n    border-radius: 20px;\n    margin-left: 0.5rem;\n  }\n  footer {\n    text-align: center;\n    padding: 2rem 1rem;\n    color: #484f58;\n    font-size: 0.78rem;\n    border-top: 1px solid #21262d;\n    margin-top: 3rem;\n  }\n</style>\n</head>\n<body>\n  <nav>\n    <span class=\"nav-brand\">&#128274; SecNotes</span>\n    <div class=\"nav-links\">\n      <a href=\"/\">Home</a>\n      <a href=\"/comments\">Comentários</a>\n      <a href=\"/login\">Login</a>\n    </div>\n  </nav>\n  <div class=\"login-wrapper\">\n    <div class=\"login-card\">\n      <h2>&#128274; Acesso Restrito</h2>\n      <form method=\"POST\" action=\"/login\">\n        <div class=\"form-group\"><label>Usuário</label><input type=\"text\" name=\"username\" placeholder=\"admin\" required></div>\n        <div class=\"form-group\"><label>Senha</label><input type=\"password\" name=\"password\" placeholder=\"••••••••\" required></div>\n        <button type=\"submit\" class=\"btn\" style=\"width:100%\">Entrar</button>\n      </form>\n    </div>\n  </div>\n  <footer>SecNotes &copy; 2025 &mdash; fins educacionais</footer>\n</body>\n</html>\n"
