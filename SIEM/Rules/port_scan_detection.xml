<!-- as regras abaixo foram criadas para identificar e diferenciar 1 scan via TCP de 1 via UPD , visando possiveis regras que serão criadas futuramente -->
<group name="opnsense,scan,Tcp_scan">

  <rule id="110002" level="8" frequency="15" timeframe="60">

    <if_matched_group>firewall</if_matched_group>

    <field name="net_protocol">tcp</field>

    <same_srcip />

    <different_dstport />

    <description>Possível port scan detectado pelo OPNsense</description>

    <group>port_scan,reconnaissance,attack</group>
    
    <mitre> <id>T1046</id> </mitre>

  </rule>

</group>

<group name="opnsense,scan,Udp_scan">

  <rule id="110003" level="8" frequency="15" timeframe="60">

    <if_matched_group>firewall</if_matched_group>

    <field name="net_protocol">UDP</field>

    <same_srcip />

    <different_dstport />

    <description>Possível port scan via UDP detectado pelo OPNsense</description>

    <group>port_scan,reconnaissance,attack,UDP_SCAN</group>
    
    <mitre> <id>T1046</id> </mitre>

  </rule>

</group>
