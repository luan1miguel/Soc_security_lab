<decoder name="opnsense-filterlog">
  <prematch>filterlog</prematch>
</decoder>

<decoder name="opnsense-network">
  <parent>opnsense-filterlog</parent>

  <regex type="pcre2">[0-9]+,,,(.*?),(.*?),(.*?),(pass|block),(in|out),([0-9]+),.*?,.*?,.*?,.*?,.*?,.*?,.*?,.*?,([0-9]+\.[0-9]+\.[0-9]+\.[0-9]+),([0-9]+\.[0-9]+\.[0-9]+\.[0-9]+),([0-9]+),([0-9]+)</regex>

  <order>tracker,interface,reason,fw_action,direction,ip_version,srcip,dstip,srcport,dstport</order>
</decoder>
